SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-level-token
PORT=3000
SIGNALROOM_AI_ENABLED=true
# Enable RTS only when Slack assistant search context is available.
# If not available, SignalRoom safely falls back to channel history.
SIGNALROOM_RTS_ENABLED=true
SIGNALROOM_MCP_ENABLED=false
SIGNALROOM_DEBUG=false

# Optional MCP integrations. Comma-separate multiple MCP HTTP endpoints.
# Each server should expose a tool named signalroom.project_context that returns
# { messages, issues, docs, calendar } as structuredContent or JSON text.
MCP_SERVER_URLS=
MCP_SERVER_TOKENS=

# Optional direct API keys for local MCP adapter clients.
GITHUB_TOKEN=
LINEAR_API_KEY=
NOTION_TOKEN=
